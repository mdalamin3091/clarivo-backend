generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── better-auth core tables ──────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
}

model Session {
  id                   String   @id @default(uuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId, providerId])
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([identifier])
}

// ─── better-auth organization plugin tables ───────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  // Onboarding fields
  modules       String[]
  accessibility String   @default("public")
  teamSize      String?

  // Public portal menu configuration
  publicPortalMenus Json?

  // Branding fields
  displayName  String?
  brandColor   String?
  darkBgColor  String?
  defaultTheme String? @default("system")
  socialImage  String?

  // Global board settings
  hideLeaderBoard Boolean?            @default(false)
  defaultSorting  BoardDefaultSorting @default(trending)

  // Global board greeting / typography defaults (JSON)
  // { welcomingTitle, welcomingDescription, postCreationButtonText }
  boardGreeting Json?

  // status settings
  hideCompletedAndCanceledStatuses Boolean @default(false)
  hideAllStatusesFromPublicView    Boolean @default(false)

  // tag settings
  allowUserToTaggingPosts Boolean @default(false)

  // global access and privacy settings

  // guest access 
  anonymousPosting    Boolean @default(false)
  anonymousCommenting Boolean @default(false)
  anonymousUpvoting   Boolean @default(true)

  //moderation
  postModeration    Boolean @default(false)
  commentModeration Boolean @default(false)

  //privacy
  privateEta Boolean @default(false) // (Estimated time to arrival)

  boards      Board[]
  members     Member[]
  invitations Invitation[]

  // voting settings 
  downVoting               Boolean @default(false)
  hideVotedCountUntilVoted Boolean @default(false)

  statuses     Status[]
  tags         Tag[]
  customFields CustomField[]

  roadmaps Roadmap[]

  feedbacks Feedback[]
}

model Feedback {
  id             String     @id @default(cuid())
  organizationId String
  boardId        String
  authorId       String
  statusId       String?
  title          String
  description    Json?
  postVisibility Visibility @default(public)
  enableComment  Boolean    @default(true)
  pinnedAt       DateTime?  // null = not pinned; set to timestamp when pinned (used for ordering)
  eta            DateTime?  // optional target / due date set by admins

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  board        Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author       Member            @relation(name: "author", fields: [authorId], references: [id])
  status       Status?           @relation(fields: [statusId], references: [id], onDelete: SetNull)
  tags         FeedbackTag[]
  assignees    FeedbackAssignee[]

  votes    Vote[]
  comments Comment[]

  @@index([organizationId])
  @@index([boardId])
  @@index([statusId])
  @@index([authorId])
}

model FeedbackTag {
  feedbackId String
  tagId      String

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([feedbackId, tagId])
  @@index([feedbackId])
  @@index([tagId])
}

model FeedbackAssignee {
  feedbackId String
  memberId   String

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([feedbackId, memberId])
  @@index([feedbackId])
  @@index([memberId])
}

// One row = one user's single vote on a feedback post.
// Aggregate counts are derived at query time (COUNT WHERE type = upvote/downvote).
model Vote {
  id         String   @id @default(cuid())
  feedbackId String
  voterId    String
  type       VoteType @default(upvote)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  voter    Member   @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, voterId])
  @@index([feedbackId])
}

model Comment {
  id         String  @id @default(cuid())
  feedbackId String
  authorId   String
  parentId   String? // null = top-level comment; set = reply
  content    Json    // Tiptap JSON document
  isEdited   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback Feedback      @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   Member        @relation(fields: [authorId], references: [id])
  parent   Comment?      @relation(name: "replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("replies")
  votes    CommentVote[]

  @@index([feedbackId])
  @@index([parentId])
  @@index([authorId])
}

// One row = one user's single vote on a comment.
model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  voterId   String
  type      VoteType @default(upvote)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  voter   Member  @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([commentId, voterId])
  @@index([commentId])
}

model Member {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdFeedbacks   Feedback[]         @relation(name: "author")
  assignedFeedbacks  FeedbackAssignee[]
  votes              Vote[]
  commentVotes       CommentVote[]
  comments           Comment[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Board {
  id             String @id @default(uuid())
  organizationId String
  name           String
  slug           String

  // Icon: { type: "predefined" | "emoji", value: "MessageSquare" }
  icon Json

  defaultSorting BoardDefaultSorting @default(trending)

  // Board-level greeting / typography overrides (JSON)
  // { welcomingTitle, welcomingDescription, postCreationButtonText }
  greeting Json?

  visibility               Visibility @default(public)
  allowSubscribe           Boolean    @default(true)
  disableFollowupQuestions Boolean    @default(false)
  disableEndUserPosting    Boolean    @default(false)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customFields CustomField[]
  feedbacks    Feedback[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Roadmap {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  description    String?
  // Icon: { type: "predefined" | "emoji", value: "Map" }
  icon           Json
  visibility     RoadmapVisibility @default(everyone)
  baseFilter     String            @default("")
  copiedFromId   String?
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  copiedFrom   Roadmap?        @relation("RoadmapCopies", fields: [copiedFromId], references: [id])
  copies       Roadmap[]       @relation("RoadmapCopies")
  columns      RoadmapColumn[]

  @@index([organizationId])
}

model RoadmapColumn {
  id          String   @id @default(uuid())
  roadmapId   String
  name        String
  description String?
  // Icon: { type: "predefined" | "emoji", value: "Circle" }
  icon        Json?
  color       String
  baseFilter  String   @default("")
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

model Status {
  id             String  @id @default(uuid())
  name           String
  color          String
  isDefault      Boolean @default(false)
  order          Int     @default(0)
  organizationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedbacks    Feedback[]

  @@index([organizationId])
}

model Tag {
  id             String   @id @default(uuid())
  name           String
  color          String
  isPrivate      Boolean  @default(false)
  organizationId String
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedbacks    FeedbackTag[]

  @@index([organizationId])
}

model CustomField {
  id                   String          @id @default(cuid())
  organizationId       String
  name                 String
  type                 CustomFieldType
  options              String[]
  placeholder          String?
  isRequired           Boolean         @default(false)
  isPrivate            Boolean         @default(false)
  showAnswerToEveryone Boolean         @default(false)
  order                Int             @default(0)
  
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  boards       Board[]

  @@index([organizationId])
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Visibility {
  public
  private
}

enum VoteType {
  upvote
  downvote
}

enum RoadmapVisibility {
  everyone
  teamOnly
}

enum BoardDefaultSorting {
  trending
  recent
  oldest
  top
}

enum CustomFieldType {
  text
  number
  url
  date
  boolean
  dropdown
  multiselect
}
